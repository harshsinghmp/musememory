---
/**
 * Site header, shared by every page.
 *
 * The mobile menu is a `<details>`/`<summary>` pair rather than a JS toggle:
 * it opens and closes with zero script, stays keyboard-operable, and
 * announces its state to assistive tech for free.
 */
import Logo from "./Logo.astro";

const base = import.meta.env.BASE_URL;
interface Props {
  ctaHref?: string;
  links?: Array<{ href: string; label: string }>;
}
const {
  ctaHref = `${base}/#install`,
  links = [
    { href: `${base}/#problem`, label: "Problem" },
    { href: `${base}/#demo`, label: "Demo" },
    { href: `${base}/#architecture`, label: "Architecture" },
    { href: `${base}/#surface`, label: "Surface" },
    { href: `${base}/#compare`, label: "Compare" },
    { href: `${base}/docs`, label: "Docs" },
  ],
} = Astro.props;
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand-link" href={`${base}/`} aria-label="Muse Memory — home">
      <Logo withWordmark />
    </a>

    <nav class="nav-links" aria-label="Main">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <div class="nav-actions">
      <a class="btn btn-primary nav-cta" href={ctaHref}>Get started</a>

      <details class="nav-menu">
        <summary aria-label="Open navigation menu">
          <span class="bars" aria-hidden="true"></span>
        </summary>
        <nav class="nav-sheet" aria-label="Mobile">
          {links.map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
          <a href="https://github.com/harshsinghmp/musememory" rel="noopener">GitHub ↗</a>
          <a href="https://www.npmjs.com/package/musememory" rel="noopener">npm ↗</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .brand-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-primary);
    flex: none;
  }
  .brand-link:hover { text-decoration: none; }

  .nav-actions {
    display: flex;
    align-items: center;
    /* Without this the group packs to the start of the row, which drags the
       absolutely-positioned sheet off the left edge of the viewport. */
    justify-content: flex-end;
    gap: var(--space-xs);
    margin-inline-start: auto;
  }

  .nav-menu {
    display: none;
    position: relative;
  }
  .nav-menu > summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: rgb(255 255 255 / 3%);
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .nav-menu > summary::-webkit-details-marker { display: none; }
  .nav-menu > summary:hover { background: rgb(255 255 255 / 7%); }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    inline-size: 17px;
    block-size: 2px;
    border-radius: 2px;
    background: var(--text-primary);
    transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-fast) var(--ease-standard);
  }
  .bars { position: relative; }
  .bars::before,
  .bars::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
  }
  .bars::before { top: -6px; }
  .bars::after { top: 6px; }

  .nav-menu[open] .bars { background: transparent; }
  .nav-menu[open] .bars::before { transform: translateY(6px) rotate(45deg); }
  .nav-menu[open] .bars::after { transform: translateY(-6px) rotate(-45deg); }

  .nav-sheet {
    position: absolute;
    inset-inline-end: 0;
    inset-block-start: calc(100% + var(--space-xs));
    min-inline-size: 14rem;
    /* Never wider than the viewport, whatever the content. */
    max-inline-size: calc(100vw - var(--gutter) * 2);
    display: grid;
    gap: 0.1rem;
    padding: var(--space-xs);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    background: var(--surface-panel);
    box-shadow: var(--shadow-xl);
  }
  .nav-sheet a {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .nav-sheet a:hover {
    color: var(--text-primary);
    background: rgb(255 255 255 / 5%);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .nav-menu { display: block; }
  }
  /* The CTA stays visible on phones — it is the primary action, and the
     mobile menu already covers navigation. It only gets more compact. */
  @media (max-width: 420px) {
    .nav-cta {
      padding: 0.6em 0.95em;
      font-size: var(--text-2xs);
    }
  }
</style>
