---
/**
 * Site footer, shared by every page. Four link columns plus the wordmark
 * block, so a visitor who lands on /compare or /docs can still reach the
 * install instructions, the repo and the package.
 */
import Logo from "./Logo.astro";
import claims from "../../../../claims.json";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const columns = [
  {
    title: "Product",
    links: [
      { href: `${base}/#problem`, label: "Why agents forget" },
      { href: `${base}/#demo`, label: "See it work" },
      { href: `${base}/#architecture`, label: "Architecture" },
      { href: `${base}/#proof`, label: "Benchmarks" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: `${base}/docs`, label: "Docs home" },
      { href: `${base}/docs#quickstart`, label: "Quickstart" },
      { href: `${base}/docs#cli`, label: "CLI reference" },
      { href: `${base}/docs#mcp`, label: "MCP tools" },
    ],
  },
  {
    title: "Code",
    links: [
      { href: "https://github.com/harshsinghmp/musememory", label: "GitHub", external: true },
      { href: "https://www.npmjs.com/package/musememory", label: "npm", external: true },
      { href: "https://github.com/harshsinghmp/musememory/blob/main/CHANGELOG.md", label: "Changelog", external: true },
      { href: "https://github.com/harshsinghmp/musememory/blob/main/LICENSE", label: "MIT licence", external: true },
    ],
  },
  {
    title: "Agents",
    links: [
      { href: `${base}/llms.txt`, label: "llms.txt" },
      { href: `${base}/llms-full.txt`, label: "llms-full.txt" },
      { href: "https://github.com/harshsinghmp/musememory/blob/main/docs/agent-reference.md", label: "Agent reference", external: true },
      { href: "https://github.com/harshsinghmp/musememory/blob/main/docs/cli-reference.md", label: "CLI reference", external: true },
    ],
  },
];
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="footer-logo" href={`${base}/`} aria-label="Muse Memory — home">
        <Logo withWordmark />
      </a>
      <p>
        Persistent, local-first memory for AI coding agents. Runs in-process on
        your machine — no account, no API key, no background daemon.
      </p>
      <p class="footer-meta">
        MIT licensed · v{claims.version} · {claims.tests.count.toLocaleString("en-US")} tests green
      </p>
    </div>

    {columns.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <p class="footer-col-title">{col.title}</p>
        {col.links.map((l) => (
          <a href={l.href} rel={l.external ? "noopener" : undefined}>{l.label}</a>
        ))}
      </nav>
    ))}
  </div>

  <div class="container footer-base">
    <p>Muse Memory — persistent memory for AI coding agents that verifies itself.</p>
    <p>All data stays on your machine. Nothing is uploaded.</p>
  </div>
</footer>

<style>
  .footer {
    border-block-start: 1px solid var(--border-subtle);
    background: var(--surface-raised);
    padding-block: var(--space-2xl) var(--space-lg);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(4, minmax(0, 1fr));
    gap: var(--space-xl);
  }
  .footer-logo {
    display: inline-flex;
    color: var(--text-primary);
  }
  .footer-logo:hover { text-decoration: none; }
  .footer-brand p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    margin-block-start: var(--space-sm);
    max-width: 34ch;
  }
  .footer-brand .footer-meta {
    color: var(--text-tertiary);
    font-size: var(--text-2xs);
    font-family: var(--font-mono);
  }
  .footer-col {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }
  .footer-col-title {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-block-end: var(--space-3xs);
  }
  .footer-col a {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
  .footer-col a:hover {
    color: var(--text-primary);
    text-decoration: none;
  }
  .footer-base {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--border-subtle);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-xs);
    color: var(--text-tertiary);
    font-size: var(--text-xs);
  }
  @media (max-width: 960px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
