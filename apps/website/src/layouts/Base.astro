---
/**
 * The one HTML shell every page uses.
 *
 * SEO contract (kept here so it cannot drift per page):
 *   - one canonical URL, derived from `site` + the built path
 *   - complete Open Graph + Twitter card set, with an absolute image URL
 *     (relative OG image URLs are silently dropped by most scrapers)
 *   - icon set covering SVG, PNG and Apple touch
 *   - a `robots` directive and a `theme-color` for the browser chrome
 *
 * Every URL is built from `import.meta.env.BASE_URL`: the site is served
 * from /musememory/, so a root-absolute path resolves on the domain root
 * and 404s.
 */
import "../styles/global.css";
import { initMotion } from "../scripts/motion.ts";
import claims from "../../../../claims.json";

interface Props {
  title?: string;
  description?: string;
  /** Path (relative to `public/`) of the social card image. */
  ogImage?: string;
  /** Canonical path of this page, e.g. "/docs". Defaults to the built path. */
  canonicalPath?: string;
  /** `index` for the landing page, `noindex` for thin/utility pages. */
  robots?: string;
  /** JSON-LD blocks to emit in <head>. */
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  title = "musememory — your AI agent gets a memory that lasts",
  description = `musememory saves what your AI coding agent learns to plain files on your machine, then hands the right notes back next session. No cloud, no daemon, no re-explaining. ${claims.agentPlatforms} platforms wired in one command — free, MIT, runs offline.`,
  ogImage = "brand/og.png",
  canonicalPath,
  robots = "index, follow, max-image-preview:large, max-snippet:-1",
  jsonLd = [],
} = Astro.props;

const base = import.meta.env.BASE_URL;
// `BASE_URL` has no trailing slash, so resolving "brand/og.png" against it
// treats "musememory" as a file and drops it: /brand/og.png. Force the
// directory form before resolving, or every social card URL 404s.
const baseUrl = new URL(base.endsWith("/") ? base : `${base}/`, Astro.site ?? "https://harshsinghmp.github.io");
const ogAbs = new URL(ogImage.replace(/^\//, ""), baseUrl).href;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? "https://harshsinghmp.github.io").href;
const motionScript = initMotion();
---

<!doctype html>
<html lang="en">
  <head>
    {/* CSP first, so the policy is installed before any subresource in the
        document is fetched. GitHub Pages cannot send response headers, so a
        meta policy is the only enforcement available — and it cannot carry
        `frame-ancestors` (that directive is ignored in a meta CSP; framing is
        only preventable from a header-delivered policy).

        What the policy has to admit, and why:
          - 'self' for the bundled CSS, the Inter woff2 files and every
            same-origin asset under /musememory/;
          - 'unsafe-inline' for the inlined motion runtime, the JSON-LD blocks,
            the playground's inline tab script and the per-element style
            attributes Astro emits;
          - 'wasm-unsafe-eval' for the playground, which runs real SQLite via
            sql.js (WebAssembly compilation is otherwise blocked);
          - data: images for the inline SVG/data-URI artwork;
          - connect-src 'self' for the wasm fetch.
        There are no third-party origins left to allow: Inter is self-hosted
        from public/fonts/, so font-src stays 'self'. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#07090f" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:site_name" content="musememory" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:image:secure_url" content={ogAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="musememory — your agent forgets everything. Give it a memory that lasts." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <meta name="twitter:image:alt" content="musememory — your agent forgets everything. Give it a memory that lasts." />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/icon-192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />

    {/* Inter is self-hosted from `public/fonts/`, so no page load touches a
        third-party origin — which is what makes the site's "nothing is
        uploaded" claim true. Preloading the vendored subset lets the swap land
        on first paint instead of after a round trip. `crossorigin` is required
        even same-origin: font fetches are always CORS-mode, and a preload
        without it does not match the real request and is fetched twice. */}
    <link
      rel="preload"
      href={`${base}/fonts/inter-var.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    {jsonLd.map((block) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(block)}
      />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <noscript>
      {/* The scroll-reveal animation ships elements at opacity 0 and lets the
          IntersectionObserver show them. Without script nothing would ever
          reveal them, so the page would read as a hero followed by blank
          space. This restores the static, fully-readable document. */}
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
        .copy {
          display: none !important;
        }
      </style>
    </noscript>
    <slot />
    <script is:inline set:html={motionScript} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 50%;
    top: 0;
    translate: -50% -120%;
    z-index: 100;
    padding: 0.7rem 1.2rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    background: var(--accent-primary);
    color: #fff;
    font-weight: 600;
    transition: translate 0.2s ease;
  }
  .skip-link:focus {
    translate: -50% 0;
    text-decoration: none;
  }
</style>
