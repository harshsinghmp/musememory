---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import claims from "../../../../claims.json";

const base = import.meta.env.BASE_URL;

const rows = [
  { cap: "Runs 100% local — zero daemons, zero cloud", muse: "yes", vec: "no", graph: "no", session: "yes" },
  { cap: "Keyless mode (no LLM / embedding API)", muse: "yes", vec: "no", graph: "no", session: "partial" },
  { cap: "Sub-2ms in-process retrieval", muse: "yes", vec: "no", graph: "no", session: "partial" },
  { cap: "Write-time citation verification", muse: "yes", vec: "no", graph: "no", session: "no" },
  { cap: "Recall-time freshness gate (withhold stale)", muse: "yes", vec: "no", graph: "partial", session: "no" },
  { cap: "Deterministic lifecycle state machine", muse: "yes", vec: "no", graph: "yes", session: "no" },
  { cap: "Structural code anchors (line-invariant)", muse: "yes", vec: "no", graph: "no", session: "no" },
  { cap: "Secret defense on every write path", muse: "yes", vec: "no", graph: "no", session: "partial" },
  { cap: "One command wires the majority of coding agents", muse: "yes", vec: "partial", graph: "partial", session: "partial" },
  { cap: "Git-reviewable memory files", muse: "yes", vec: "no", graph: "no", session: "no" },
  { cap: "Lifecycle hooks (hands-free capture/inject)", muse: "yes", vec: "partial", graph: "partial", session: "yes" },
  { cap: "Token-budgeted fused context tool", muse: "yes", vec: "partial", graph: "no", session: "no" },
  { cap: "Scoped failure attribution & decaying strikes", muse: "yes", vec: "no", graph: "no", session: "no" },
  { cap: "Trajectory fix-pair negative memory mining", muse: "yes", vec: "no", graph: "no", session: "no" },
];

const cols = [
  { key: "muse", label: "Muse Memory", sub: "local-first memory engine" },
  { key: "vec", label: "Vector stores", sub: "dense embedding-based" },
  { key: "graph", label: "Graph platforms", sub: "entity relationship-based" },
  { key: "session", label: "Session search", sub: "retroactive lookup-only" },
];

const icon = (v: string) => (v === "yes" ? "✓" : v === "partial" ? "~" : "✕");
const cls = (v: string) => (v === "yes" ? "yes" : v === "partial" ? "part" : "no");
---

<Base title="Muse Memory vs vector stores, graph platforms, session search" description="A 14-capability comparison of Muse Memory against vector stores, knowledge-graph platforms, and session search tools. Muse is the only one that is simultaneously local-first, fully keyless, and git-versioned.">
  <Nav
    links={[
      { href: `${base}/#how-it-works`, label: "How it works" },
      { href: `${base}/#capabilities`, label: "Capabilities" },
      { href: `${base}/#proof`, label: "Benchmarks" },
      { href: `${base}/docs`, label: "Docs" },
    ]}
  />

  <main id="main">
    <section class="section">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Landscape</p>
          <h1>Four approaches to agent memory</h1>
          <p>
            Vector stores optimize for semantic similarity, graph platforms for entity
            relationships, session search for retroactive lookup. Muse optimizes for the thing
            coding agents actually need: <strong>verified, code-grounded recall that never serves stale truth</strong>.
          </p>
          <p class="plain">
            <strong>The differentiator:</strong> while other approaches serve memory at confidence,
            Muse verifies it at both write and recall. Notes are checked against your real code
            before they enter the store, and withheld if the code has drifted since they were
            written. Nothing is served as truth that cannot be traced to a structural anchor.
          </p>
        </div>

        <div class="table-wrap reveal">
          <table class="compare">
            <caption class="sr-only">
              Capability comparison between Muse Memory, dense vector stores,
              entity-relationship graph platforms, and session search tools.
            </caption>
            <thead>
              <tr>
                <th scope="col">Capability</th>
                {cols.map((c) => (
                  <th scope="col">
                    {c.label}<br /><span class="th-sub">{c.sub}</span>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <th scope="row">{r.cap}</th>
                  {cols.map((c) => (
                    <td class={cls(r[c.key] as string)} class:list={{ musecol: c.key === "muse" }}>
                      {icon(r[c.key] as string)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class="legend">
          <span class="yes">✓</span> documented capability ·
          <span class="part">~</span> partial / requires setup or paid tier ·
          <span class="no">✕</span> not documented
        </p>
        <p class="table-note">
          Methodology: capability claims follow a documented-features-only standard — code beats docs, quick evolutions on all sides. Muse row reflects v{claims.version}.
        </p>
      </div>
    </section>

    <section class="cta-final">
      <div class="container cta-inner">
        <h2>Verified memory beats confident guesswork</h2>
        <div class="cta-actions">
          <a class="btn btn-primary btn-lg" href={`${base}/#install`}>Install now</a>
          <a class="btn btn-ghost btn-lg" href={`${base}/docs`}>Read the docs</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .table-wrap { overflow-x: auto; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--surface-panel); }
    .compare { width: 100%; border-collapse: collapse; font-size: 0.92rem; min-width: 760px; }
    .compare th, .compare td { padding: 0.85rem 1.1rem; text-align: left; border-bottom: 1px solid var(--border-subtle); }
    .compare thead th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-secondary); background: rgba(139,124,247,0.05); }
    .th-sub { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--text-tertiary); font-size: 0.74rem; }
    .compare tbody tr:last-child td { border-bottom: none; }
    .compare tbody tr:hover td { background: rgba(139,124,247,0.04); }
    .compare td:not(:first-child) { text-align: center; font-size: 1rem; }
    .musecol { font-weight: 700; }
    .yes { color: var(--accent-success); font-weight: 600; }
    .part { color: var(--accent-warning); font-weight: 600; }
    .no { color: var(--text-tertiary); }
    .legend { margin-top: 1rem; font-size: 0.85rem; color: var(--text-secondary); display: flex; gap: 1.2rem; flex-wrap: wrap; }
    .table-note { margin-top: 0.6rem; font-size: 0.8rem; color: var(--text-tertiary); max-width: 70ch; }
    .cta-final {
      padding: clamp(3rem, 8vw, 5.5rem) 0;
      text-align: center;
      background: radial-gradient(40rem 20rem at 50% 120%, rgba(139,124,247,0.18), transparent 65%), var(--surface-raised);
      border-top: 1px solid var(--border-subtle);
    }
    .cta-inner h2 { font-size: var(--text-2xl); margin-bottom: 1.5rem; }
    .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-lg { padding: 1em 2em; font-size: 1rem; }
  </style>
</Base>
