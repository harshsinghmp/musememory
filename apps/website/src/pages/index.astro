---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
// The countable claims come from the generated manifest, not from prose, so
// the site can never advertise a number the code does not produce. See
// scripts/generate-claims.ts and test/marketing_claims.test.ts.
import claims from "../../../../claims.json";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/harshsinghmp/musememory";
const npm = "https://www.npmjs.com/package/musememory";

/* ── The problem, in the reader's words ─────────────────────────────────── */
const problems = [
  {
    title: "Every session starts from zero",
    body: "Your assistant only knows what fits in its context window. Close the chat and that knowledge is gone — so tomorrow you explain the architecture again.",
    icon: "reset",
  },
  {
    title: "Memory ignores your git state",
    body: "You checkout a branch and your memory still carries rules from the experiment you abandoned. Stale facts leak between features and contaminate stable code.",
    icon: "branch",
  },
  {
    title: "You're paying token rent on a flat file",
    body: "Using a global MEMORY.md as your store is a cache-killer. Every memory update invalidates your entire prefix cache, forcing you to re-process everything from scratch — every session.",
    icon: "coin",
  },
  {
    title: "Memory drifts without blame",
    body: "There's no git blame for memory. A hallucinated rule from one session poisons every future recall, and there's no checkout or rollback to undo it.",
    icon: "blame",
  },
] as const;

/* ── How it works: plain sentence first, precise detail second ──────────── */
const steps = [
  {
    step: "01",
    title: "Remember it",
    plain:
      "When your assistant makes a decision or fixes a bug, Muse saves a short note about it — what changed and why.",
    tech: "Capture is optional per project and every write passes the Vibeguard credential scanner before it touches disk.",
  },
  {
    step: "02",
    title: "Check it",
    plain:
      "Before a note is stored, Muse confirms the file or function it mentions actually exists. If that code later changes, Muse notices and flags the note.",
    tech: "Anchors are structural fingerprints that survive refactors, not line numbers. Unverifiable citations are refused at write time.",
  },
  {
    step: "03",
    title: "Hand it back",
    plain:
      "Next time you start work, Muse returns the notes that fit the task — a short list sized to your budget, not the whole archive.",
    tech: "One in-process query over SQLite FTS5, under 2ms, with a hard token budget. No daemon, no network, no model call.",
  },
];

/* ── Capabilities: the core pillars ────────────────────────────────────── */
const pillars = [
  {
    tag: "verified",
    color: "violet",
    title: "Refuses to save what it can't check",
    body: "A note that points at a file or function which doesn't exist is rejected on the spot. Your assistant can't quietly file facts about code that was never there — and a hallucinated citation never reaches the store.",
    stat: "citations verified at write time",
  },
  {
    tag: "fair blame",
    color: "cyan",
    title: "Never blames the innocent note",
    body: "When tests or commands fail, Muse scopes attribution strictly to memories that match the failed file or symbol. Retry loops are deduplicated to 1 strike, strikes decay after clean runs, and constitutional rules are immune from automated dispute.",
    stat: "scoped failure attribution (v3.0)",
  },
  {
    tag: "negative mining",
    color: "amber",
    title: "Turns errors into permanent lessons",
    body: "Muse watches the Error ➔ Remediation ➔ Success sequence in your session logs and distills actionable 'AVOID' negative memories with normalized error signatures and zero secret leakage.",
    stat: "fix-pair trajectory mining (v3.0)",
  },
  {
    tag: "instant",
    color: "cyan",
    title: "Answers without waiting",
    body: "Recall runs on your machine in under two milliseconds. There is no upload, no embedding API and no round trip, so looking something up never turns into a coffee break.",
    stat: "sub-2ms recall",
  },
  {
    tag: "one command",
    color: "amber",
    title: "Sets itself up",
    body: `One command finds the AI tools you already have and connects them. If you've been using another memory tool, the importer reads ${claims.migratorProviders} formats so your history comes with you instead of starting empty.`,
    stat: `${claims.agentPlatforms} coding agents auto-wired`,
  },
  {
    tag: "self-tidying",
    color: "green",
    title: "Cleans up after itself",
    body: "Notes move through a fixed lifecycle — proposed, confirmed, replaced, archived — with age limits per type. The store stays useful instead of growing into a landfill you never open.",
    stat: "7-state lifecycle",
  },
  {
    tag: "refactor-proof",
    color: "violet",
    title: "Survives your refactors",
    body: "Notes are tied to code structure rather than line numbers, so moving a function doesn't silently break them. When real drift happens, the note is withheld at recall and you're told, instead of being served stale advice.",
    stat: "line-invariant anchors",
  },
  {
    tag: "zero leakage",
    color: "red",
    title: "Keeps secrets out",
    body: "Every write — captures, imports, sync packets — is scanned for API keys, tokens and passwords. Anything that looks like a credential is refused before it lands in a file you might later commit.",
    stat: `${claims.credentialRuleFamilies} credential rule families`,
  },
];

/* ── Proof ─────────────────────────────────────────────────────────────── */
const benchmarks = [
  { label: "Recall latency", value: "sub-2ms", note: "SQLite FTS5 BM25, in-process" },
  { label: "Hot cache lookup", value: "<50µs", note: "L0 in-process cache" },
  { label: "Coding agents wired", value: String(claims.agentPlatforms), note: "detected and connected over MCP" },
  { label: "Import formats", value: String(claims.migratorProviders), note: "legacy memory systems" },
  { label: "Tests passing", value: claims.tests.count.toLocaleString("en-US"), note: `${claims.tests.files} files, runs offline` },
  { label: "Background services", value: String(claims.backgroundDaemons), note: "nothing to keep running" },
];

const trustChecks = [
  { text: "A secret gets captured", got: "write refused before it hits disk", color: "red" },
  { text: "A note cites a deleted file", got: "flagged as orphaned, audited", color: "amber" },
  { text: "Two facts contradict", got: "marked conflicted, with a way to resolve", color: "cyan" },
  { text: "A citation was invented", got: "rejected at the door", color: "violet" },
];

/* ── The tool strip: names, not logos — no trademark permission needed ── */
const tools = [
  "Claude Code",
  "Cursor",
  "Codex",
  "Windsurf",
  "Gemini CLI",
  "OpenCode",
  "Aider",
  "Cline",
  "Roo Code",
  "Continue",
  "Amp",
  "Zed",
];

/* ── Why versioned memory matters ──────────────────────────────────────── */
const versionedReasons = [
  {
    title: "Branch-aware memory prevents contamination",
    body: "Without version-aware memory, checking out a hotfix still carries experimental notes from a feature branch. Muse scopes memory to your git branch so each line of development sees only what is true for it.",
  },
  {
    title: "Compile, don't retrieve",
    body: "Raw observations pile up into noise. Muse compiles them — distilling, deduplicating, superseding — so recall returns a curated summary instead of a search result you have to re-read.",
  },
  {
    title: "Git-blamable memory",
    body: "Every memory is traceable. When a note is wrong, git blame shows who wrote it and when — just like your source code. Audit. Revert. Learn.",
  },
];

/* ── What actually lands on disk ───────────────────────────────────────── */
const storeTree = [
  { path: ".memory/", note: "Project scope — travels with your repo" },
  { path: "  memory.db", note: "SQLite: memories, anchors, graph edges, audit" },
  { path: "  memories/", note: "One YAML file per memory — plain text, reviewable" },
  { path: "  CURRENT.md", note: "Active constraints, injected every session" },
  { path: "  observations.jsonl", note: "Append-only event log the harvester mines" },
  { path: "~/.memory/", note: "Global scope — preferences that follow you" },
];

/* ── Glossary: literal term/definition pairs, so answer engines can parse
   them without guessing, and a non-technical reader can keep up. ───────── */
const glossary = [
  {
    term: "AI coding agent",
    def: "An AI assistant that reads and edits code in your project — Claude Code, Cursor, Codex, Windsurf and similar tools.",
  },
  {
    term: "Agent memory",
    def: "What an assistant keeps between sessions: decisions, fixes and preferences it can look up later instead of rediscovering.",
  },
  {
    term: "Context window",
    def: "The fixed amount of text an assistant can consider at once. Anything outside it is invisible, which is why sessions forget.",
  },
  {
    term: "MCP",
    def: "Model Context Protocol — the standard way assistants connect to outside tools like Muse. You never have to use the acronym.",
  },
  {
    term: "Local-first",
    def: "The data lives and is processed on your own machine. No account, no upload, no service that can go down or change its pricing.",
  },
  {
    term: "Code anchor",
    def: "A pointer from a note to a specific file or function. Muse uses a structural fingerprint instead of a line number so refactors don't break it.",
  },
];

/* ── FAQ: the questions a non-technical user actually asks ─────────────── */
const faqs = [
  {
    q: "Do I need to know how to program to install it?",
    a: "No, but you do need a terminal — the command is a single line you paste and run. If you can copy and paste one line of text, you can install Muse. There is no config file to write and no server to set up.",
  },
  {
    q: "Do I need an API key, an account, or a subscription?",
    a: "No account, no API key, no subscription. Muse is free and open source under the MIT licence. It does not call an AI model: recall is a database query on your own machine, so there is nothing to bill and nothing to sign up for.",
  },
  {
    q: "Where is my data stored?",
    a: "In two folders on your computer: .memory/ inside each project, and ~/.memory/ for anything that applies everywhere. They are plain SQLite and YAML files you can read, edit, back up, ignore, or commit to git. Nothing is uploaded anywhere.",
  },
  {
    q: "Will it slow my assistant down?",
    a: "No. A lookup runs in under two milliseconds locally, with a hard token budget, so it returns a short list rather than everything. That is far cheaper than re-explaining your architecture in every new session.",
  },
  {
    q: "Does it work with the AI tools I already use?",
    a: `Yes — Muse detects and connects ${claims.agentPlatforms} coding agents, including Claude Code, Cursor, Codex, Windsurf, Gemini CLI, OpenCode, Hermes and OpenClaw. One command wires each of them; you keep working exactly as you do today.`,
  },
  {
    q: "What if it remembers something wrong?",
    a: "Muse checks citations before storing them, and re-checks them at recall. If the code a note points at has changed or disappeared, the note is withheld and you are told why, rather than served as if it were still true. Contradictions are marked as conflicted rather than silently overwritten.",
  },
  {
    q: "What happens to passwords and API keys?",
    a: `They are refused. Every write is scanned for ${claims.credentialRuleFamilies} families of credential — API keys, tokens, private keys, connection strings — and a suspected secret stops the write instead of being stored in a file you might later commit.`,
  },
  {
    q: "Can I bring my existing notes or another tool's history?",
    a: `Yes. The importer reads ${claims.migratorProviders} formats from other memory systems, and existing session transcripts can be turned into candidate notes. Your memory starts populated rather than empty.`,
  },
  {
    q: "Is it really free?",
    a: "Yes. Muse is MIT-licensed with no paid tier and no telemetry. The whole engine — capture, ranking and recall — runs in-process on your machine, so there is no hosted component to charge for.",
  },
];

/* ── Structured data ───────────────────────────────────────────────────── */
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Muse Memory",
    url: "https://harshsinghmp.github.io/musememory/",
    description:
      "Persistent, local-first memory for AI coding agents. Sub-2ms recall, write-time citation verification, zero daemons.",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Muse Memory",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    softwareVersion: claims.version,
    description:
      "Persistent memory for AI coding agents that runs locally. Citations are verified at write time, stale memories are withheld at recall, failures are fairly attributed without bystander demotion, and negative lessons are autonomously mined from fix trajectories.",
    url: "https://harshsinghmp.github.io/musememory/",
    downloadUrl: npm,
    codeRepository: repo,
    license: "https://opensource.org/licenses/MIT",
    runtimePlatform: "Node.js, Bun",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: [
      "Write-time citation verification",
      "In-process retrieval engine (sub-2ms recall)",
      `One command wires ${claims.agentPlatforms} coding agents over MCP`,
      "Deterministic lifecycle and forgetting",
      "Structural code anchors that survive refactors",
      "Credential scanning on every write",
      "Scoped failure attribution and decaying strike engine (v3.0.0)",
      "Trajectory fix-pair negative memory mining (v3.0.0)",
      "HOT.md working set compounding & logarithmic frequency ranking (v3.0.0)",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to add persistent memory to an AI coding agent",
    description:
      "Install Muse Memory in one command and give your AI coding assistant memory that survives between sessions.",
    totalTime: "PT1M",
    tool: [{ "@type": "HowToTool", name: "A terminal" }],
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open a terminal in your project folder",
        text: "Open any terminal in the project you want your assistant to remember. No installation or account is required first.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Run npx musememory connect",
        text: "Run npx musememory connect. Muse detects the AI coding tools you already have and connects each one, so you do not configure them individually.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Keep working",
        text: "Your assistant now has memory tools available, including muse_context for fused recall and muse_why for explaining why code is the way it is. It starts remembering from the next session.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Muse Memory capabilities",
    itemListElement: pillars.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: p.title,
      description: p.body,
    })),
  },
];
---

<Base
  title="Muse Memory — Persistent memory for AI coding agents that verifies itself"
  description={`Muse Memory gives AI coding agents persistent memory that runs locally. Citations are verified before they are saved, stale notes are withheld at recall, and one command wires ${claims.agentPlatforms} coding agents. No account, no API key, MIT.`}
  jsonLd={jsonLd}
>
  <Nav />

  <main id="main">
    <!-- ── HERO ──────────────────────────────────────────────────────────── -->
    <section class="hero scene" aria-labelledby="hero-title">
      <div class="parallax-layer" data-parallax data-speed="0.55" aria-hidden="true">
        <div class="mesh"></div>
      </div>
      <div class="synapse-orb" style="width:34rem;height:34rem;top:-12rem;left:8%;background:var(--violet)"></div>
      <div class="synapse-orb" style="width:28rem;height:28rem;top:-6rem;right:6%;background:var(--cyan);animation-delay:-7s"></div>

      <div class="container hero-inner split scene-planes">
        <div class="hero-copy">
          <p class="hero-kicker layer z-1">
            <span class="pulse" aria-hidden="true"></span> v{claims.version} · Runs on your computer · No account · MIT
          </p>

          <h1 id="hero-title" class="layer z-2">
            <span class="hero-keyword">Persistent memory for AI coding agents</span>
            <span class="hero-promise">Stop re-explaining your codebase.</span>
          </h1>

          <p class="hero-sub layer z-1">
            Muse is a small program that lives on your computer and remembers what your AI
            assistant worked out — the decisions, the fixes, the things that broke. Before it
            hands anything back, it checks the note still matches your code.
          </p>

          <div class="hero-cta reveal" style="--reveal-delay:120ms">
            <a class="btn btn-primary btn-lg" href="#install">Install in one command</a>
            <a class="btn btn-ghost btn-lg" href="#how-it-works">See how it works</a>
          </div>

          <pre class="term hero-term layer z-1" aria-label="Terminal: install command"><code>npx musememory connect</code></pre>
        </div>

        <!-- The product, in one frame: the three outcomes a memory can have. -->
        <div class="hero-visual layer z-1">
          <ul class="hero-cards" aria-label="What Muse does with a memory">
            <li class="hero-card tilt card-sheen" data-tilt="4">
              <span class="hc-badge hc-ok" aria-hidden="true">✓</span>
              <p class="hc-title">Remembered</p>
              <p class="hc-body"><code>auth uses jose, not jsonwebtoken</code></p>
              <p class="hc-note">cited symbol exists — handed back next session</p>
            </li>
            <li class="hero-card tilt card-sheen" data-tilt="4">
              <span class="hc-badge hc-no" aria-hidden="true">✕</span>
              <p class="hc-title">Refused</p>
              <p class="hc-body"><code>see src/legacy/auth.ts</code></p>
              <p class="hc-note">file does not exist — never stored</p>
            </li>
            <li class="hero-card tilt card-sheen" data-tilt="4">
              <span class="hc-badge hc-hold" aria-hidden="true">!</span>
              <p class="hc-title">Withheld</p>
              <p class="hc-body"><code>session store uses Redis</code></p>
              <p class="hc-note">anchor drifted since last session — held back</p>
            </li>
          </ul>
        </div>
      </div>

      <!-- Proof strip: the numbers, immediately. -->
      <div class="container">
        <dl class="hero-stats reveal" style="--reveal-delay:180ms">
          {benchmarks.slice(0, 4).map((b) => (
            <div class="hero-stat">
              <dt>{b.label}</dt>
              <dd>{b.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ── TOOL STRIP ───────────────────────────────────────────────────── -->
    <section class="section-tight tools" aria-labelledby="tools-title">
      <div class="container">
        <p class="tools-title" id="tools-title">
          One command wires the tools you already use — over MCP, with no config file
        </p>
      </div>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[...tools, ...tools].map((t) => <span>{t}</span>)}
        </div>
      </div>
    </section>

    <!-- ── WHAT IS IT ───────────────────────────────────────────────────── -->
    <section class="section" id="what-is-muse" aria-labelledby="what-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Start here</p>
          <h2 id="what-title">What is Muse Memory?</h2>
        </div>
        <p class="answer">
          Muse Memory is a memory system for AI coding assistants. It saves the decisions,
          fixes and lessons from your work, then hands the right ones back in the next
          session — after checking that what it saved is still true. It runs entirely on
          your own computer.
        </p>
        <p class="plain">
          <strong>The short version:</strong> your assistant is smart but forgetful. Muse is
          the notebook it reads before it starts, with one rule — nothing goes in the
          notebook unless it can be checked against your actual code.
        </p>
      </div>
    </section>

    <!-- ── THE PROBLEM ──────────────────────────────────────────────────── -->
    <section class="section section-alt" id="problem" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The problem</p>
          <h2 id="problem-title">Why do AI coding assistants forget?</h2>
        </div>
        <p class="answer">
          An assistant only knows what fits in its context window. When the session ends
          that context is discarded, so the next session starts from zero. Muse closes the
          gap by keeping what mattered outside the model — in files on your disk — and
          loading it back when it is relevant.
        </p>
        <div class="grid problem-grid">
          {problems.map((p, i) => (
            <article class="problem-card panel reveal" style={`--reveal-delay:${i * 70}ms`}>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── HOW IT WORKS ─────────────────────────────────────────────────── -->
    <section class="section scene" id="how-it-works" aria-labelledby="how-title">
      <div class="parallax-layer" data-parallax data-speed="0.75" aria-hidden="true" style="opacity:.7">
        <div class="mesh"></div>
      </div>
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2 id="how-title">How does Muse Memory work?</h2>
        </div>
        <p class="answer">
          Three steps on a loop: it records what happened, verifies each record against your
          real code, and returns the useful ones when new work starts. If a saved fact no
          longer matches your code, Muse leaves it out instead of serving it.
        </p>

        <ol class="steps scene-planes">
          {steps.map((s, i) => (
            <li class={`step panel tilt z-${(i % 3) + 1} reveal`} data-tilt="4" style={`--reveal-delay:${i * 110}ms`}>
              <span class="step-num" aria-hidden="true">{s.step}</span>
              <h3>{s.title}</h3>
              <p class="step-plain">{s.plain}</p>
              <p class="step-tech">{s.tech}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── CAPABILITIES ─────────────────────────────────────────────────── -->
    <section class="section section-alt" id="capabilities" aria-labelledby="capabilities-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Capabilities</p>
          <h2 id="capabilities-title">What can it actually do?</h2>
          <p>
            Eight core pillars, each with the everyday explanation first and the engineering detail
            underneath. Together they are what makes this a memory you can trust rather than
            a search box over old notes.
          </p>
        </div>
        <div class="grid wide capability-grid">
          {pillars.map((p, i) => (
            <article class={`capability panel reveal`} style={`--reveal-delay:${i * 60}ms`}>
              <div class="capability-head">
                <span class={`chip chip-${p.color}`}>{p.tag}</span>
                <h3>{p.title}</h3>
              </div>
              <p class="capability-body">{p.body}</p>
              <p class="capability-stat">{p.stat}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── PROOF ────────────────────────────────────────────────────────── -->
    <section class="section" id="proof" aria-labelledby="proof-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Proof</p>
          <h2 id="proof-title">How fast is it, really?</h2>
        </div>
        <p class="answer">
          Recall takes under two milliseconds because it is a local database query, not an
          API call. The hot cache answers a lookup in under 50 microseconds, and the whole
          engine runs with no background service and no network access. These are measured
          numbers from the built-in benchmark.
        </p>
        <div class="grid narrow bench-grid scene-planes">
          {benchmarks.map((b, i) => (
            <div class={`bench panel tilt z-${(i % 3) + 1} reveal`} data-tilt="4" style={`--reveal-delay:${i * 60}ms`}>
              <p class="bench-value">{b.value}</p>
              <p class="bench-label">{b.label}</p>
              <p class="bench-note">{b.note}</p>
            </div>
          ))}
        </div>

        <div class="trust-block">
          <h3 class="trust-title">What happens when a memory is wrong?</h3>
          <p class="answer">
            Most memory tools serve whatever they stored, with full confidence. Muse gates
            every boundary — at write, at recall, and at sync — and refuses what it cannot
            verify. When it holds something back, it says so instead of staying quiet.
          </p>
          <div class="trust-list">
            {trustChecks.map((t, i) => (
              <div class="trust-row panel reveal" style={`--reveal-delay:${i * 80}ms`}>
                <span class={`chip chip-${t.color}`} aria-hidden="true">✕</span>
                <span class="trust-bad">{t.text}</span>
                <span class="trust-arrow" aria-hidden="true">→</span>
                <span class={`trust-good good-${t.color}`}>{t.got}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── WHAT LANDS ON DISK ───────────────────────────────────────────── -->
    <section class="section section-alt" id="on-disk" aria-labelledby="disk-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">On your disk</p>
