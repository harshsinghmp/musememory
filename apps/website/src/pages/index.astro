      margin-top: 1.6rem;
      color: var(--text-faint);
      font-size: var(--fs-small);
    }

    /* ── Final CTA ───────────────────────────────────────────────────────── */
    .cta-final {
      padding: clamp(3.5rem, 9vw, 6.5rem) 0;
      text-align: center;
      background:
        radial-gradient(40rem 20rem at 50% 120%, rgba(139, 124, 247, 0.18), transparent 65%),
        var(--bg-raised);
      border-top: 1px solid var(--line);
    }
    .cta-inner h2 { font-size: var(--fs-h2); margin-bottom: 0.5em; }
    .cta-inner p { color: var(--text-dim); margin-bottom: 2rem; }
    .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-lg { padding: 1em 2em; font-size: 1rem; }

    /* Depth is decoration: flatten it on phones, where translateZ costs
       legibility and buys nothing. */
    @media (max-width: 640px) {
      .layer { transform: none; }
      .step.layer, .bench.layer { transform: none; }
    }
  </style>
</Base>
