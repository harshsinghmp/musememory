        radial-gradient(40rem 20rem at 50% 120%, rgba(139, 124, 247, 0.18), transparent 65%),
        var(--bg-raised);
      border-top: 1px solid var(--line);
    }
    .cta-inner h2 { font-size: var(--fs-h2); margin-bottom: 0.5em; }
    .cta-inner p { color: var(--text-dim); margin-bottom: 2rem; }
    .cta-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

    /* Screen-reader-only text (table captions, skip targets). */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }

    /* Depth is decoration: flatten it on phones, where translateZ costs
