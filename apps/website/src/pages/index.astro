    <!-- ── INSTALL ──────────────────────────────────────────────────────── -->
    <section class="section scene" id="install" aria-labelledby="install-title">
      <div class="parallax-layer" data-parallax data-speed="0.5" aria-hidden="true">
        <div class="mesh"></div>
