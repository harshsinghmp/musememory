---
/**
 * aimm — landing page.
 *
 * Copy framework: AIDA across the page spine (Attention → Interest → Desire
 * → Action), with PAS (Problem → Agitation → Solution) driving the problem
 * block.
 *
 * Plain-language rule: second person, short sentences, concrete nouns. The
 * hero sells the outcome; the technical depth starts below the fold, where a
 * reader who wants it can find it. Words that cannot be verified are not
 * used ("world-class", "seamless", "revolutionary" are absent on purpose).
 *
 * Shape: a bento landing page. `global.css` owns the 12-column grid, the card
 * surface and the span scale; this page owns the mosaic — which card claims
 * how many columns — and the copy.
 *
 * Every countable claim comes from `claims.json`, which is generated from
 * `src/`. Nothing in this file is hand-typed except prose.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import LatencyChart from "../components/figures/LatencyChart.astro";
import LifecycleDiagram from "../components/figures/LifecycleDiagram.astro";
import ArchitectureDiagram from "../components/figures/ArchitectureDiagram.astro";
import claims from "../../../../claims.json";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/harshsinghmp/musememory";
const npm = "https://www.npmjs.com/package/musememory";

/* The proof chips under the hero. Every figure is interpolated, never typed. */
const proofChips = [
  `sub-${claims.latency.recallMillis}ms recall`,
  "runs offline",
  "MIT",
  `${claims.tests.count.toLocaleString("en-US")} tests`,
];

/* ── The problem: PAS, in the reader's words ───────────────────────────── */
const problems = [
  {
    icon: "clock-history",
    title: "Every session starts from zero",
    body: "You re-explain the architecture, the auth flow, the one decision nobody else remembers. Every morning.",
  },
  {
    icon: "git-branch",
    title: "Notes that ignore your branch",
    body: "Check out a hotfix and the agent still applies rules from the branch you left. Stale facts leak into stable code.",
  },
  {
    icon: "file-tree",
    title: "One giant notes file kills the cache",
    body: "Every edit invalidates the whole prefix. You pay to re-read the same context each session, and the file stops being anyone's source of truth.",
  },
  {
    icon: "share-network",
    title: "No blame, no rollback",
    body: "A wrong note poisons every future session. There is no blame, no checkout, and no way back to the state before the mistake.",
  },
];

/* ── The three outcomes every memory gets ─────────────────────────────── */
const outcomes = [
  {
    state: "Remembered",
    tone: "ok",
    body: "auth uses jose, not jsonwebtoken",
    note: "The cited symbol exists — handed back next session.",
  },
  {
    state: "Refused",
    tone: "no",
    body: "see src/legacy/auth.ts",
    note: "The file does not exist — the write never happens.",
  },
  {
    state: "Withheld",
    tone: "hold",
    body: "session store uses Redis",
    note: "The code drifted since the note — held back, and you are told why.",
  },
];

/* ── The bento feature grid: one outcome per card, each with real evidence ─
   `span` is the card's share of the 12-column track. The mosaic is
   8+4 / 4+4+4 / 6+6 — three whole rows, no ragged edges. */
const features = [
  {
    icon: "plug",
    span: 8,
    title: "One command wires every agent",
    body: "Run one command in your project. aimm finds the coding agents you already use and connects each one over MCP. There is no config file to hand-edit.",
    metric: `${claims.agentPlatforms} platforms`,
    cmd: "npx musememory connect",
  },
  {
    icon: "shield-check",
    span: 4,
    title: "Broken citations never land",
    body: "A note has to point at a real file or function. If the pointer is wrong, the write is refused on the spot — a guess never reaches the store.",
    metric: "refused before storage",
    cmd: "memory anchor create --file src/auth.ts --symbol verify",
  },
  {
    icon: "clock-history",
    span: 4,
    title: "Stale notes are withheld",
    body: "At recall, every note is checked against the code again. If the code moved on, the note is held back and you are told why, instead of being served as current.",
    metric: "withheld + the reason",
    cmd: 'memory recall "auth token invariant"',
  },
  {
    icon: "git-branch",
    span: 4,
    title: "Memory versions like code",
    body: "Scope a note to a branch, blame it back to the session that wrote it, and check out a state you trust.",
    metric: "branch · blame · checkout",
    cmd: "memory branch · memory blame · memory checkout",
  },
  {
    icon: "lock",
    span: 4,
    title: "Secrets stop at the door",
    body: "Every write is scanned before it is stored. A suspected key or token stops the write, and the value is never echoed back.",
    metric: "value never echoed",
    cmd: 'memory capture "auth uses jose" --project core',
  },
  {
    icon: "wand",
    span: 6,
    title: "Failures become permanent lessons",
    body: "aimm watches error → fix → no-recurrence in your session and distils a negative note, so the same mistake does not come back next week.",
    metric: "captured as a negative",
    cmd: 'memory capture --negative "AVOID: jwt.sign without an explicit algorithm"',
  },
  {
    icon: "layers",
    span: 6,
    title: "Your files, your machine",
    body: "Memory is YAML and SQLite in a folder you can open, diff, delete or commit. Nothing runs in the background, and nothing is uploaded.",
    metric: `${claims.backgroundDaemons} background services`,
    cmd: "memory files",
  },
];

/* ── Benchmarks: the numbers behind the proof bento ───────────────────── */
const benchmarks = [
  { span: 3, label: "Recall latency", value: `sub-${claims.latency.recallMillis}ms`, note: "SQLite FTS5 BM25, in-process" },
  { span: 3, label: "Hot cache lookup", value: `<${claims.latency.hotCacheMicros}µs`, note: "L0 in-process cache" },
  { span: 3, label: "Import formats", value: String(claims.migratorProviders), note: "other memory systems" },
  { span: 3, label: "Tests passing", value: claims.tests.count.toLocaleString("en-US"), note: `${claims.tests.files} files, runs offline` },
  { span: 3, label: "Background services", value: String(claims.backgroundDaemons), note: "nothing to keep running" },
  { span: 3, label: "MCP tools", value: String(claims.mcpTools), note: `${claims.mcpProfiles} task-focused profiles` },
];

/* ── Trust gates ──────────────────────────────────────────────────────── */
const gates = [
  { when: "On every write", what: "Secret scan", how: "The write is refused and the rule is named. The value is never echoed." },
  { when: "On every write", what: "Citation check", how: "A note citing a file or symbol that does not exist is refused." },
  { when: "On every recall", what: "Freshness gate", how: "Notes whose code drifted are withheld and reported, not served." },
  { when: "On every import", what: "Context stripping", how: "Injected context blocks and base64 payloads are removed before storage." },
];

/* ── The three steps: what actually happens to a memory ───────────────── */
const steps = [
  {
    n: "01",
    icon: "file-tree",
    title: "Save it",
    plain: "When your agent settles something — a decision, a fix, a constraint — aimm writes a short note: what changed and why.",
    tech: "The note lands as a readable YAML file beside a SQLite row. A credential scan runs first.",
  },
  {
    n: "02",
    icon: "anchor",
    title: "Check it",
    plain: "Before the note is stored, aimm confirms the file or function it mentions really exists.",
    tech: "Citations are structural fingerprints, not line numbers, so moving a function does not silently break the note.",
  },
  {
    n: "03",
    icon: "gauge",
    title: "Hand it back",
    plain: "Next session, aimm returns the notes that fit the task, sized to your token budget instead of the whole archive.",
    tech: "One in-process query over SQLite FTS5. Under two milliseconds, with a hard ceiling. No daemon, no network, no model call.",
  },
];

/* ── Integration surface ──────────────────────────────────────────────── */
const surfaces = [
  { icon: "terminal", name: "CLI", detail: "Scriptable, no daemon" },
  { icon: "plug", name: "MCP", detail: `${claims.mcpTools} tools over stdio` },
  { icon: "layers", name: "Profiles", detail: `${claims.mcpProfiles} task-shaped tool sets` },
  { icon: "file-tree", name: "Files", detail: "YAML + SQLite, yours to read" },
];

/* ── FAQ ──────────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: "Do I need to know how to program to install it?",
    a: "No, but you do need a terminal. The setup is one line you paste and run — no config file to write, no server to set up, no account to create.",
  },
  {
    q: "Do I need an API key or a subscription?",
    a: "No account, no API key, no subscription. aimm is MIT-licensed and free. It never calls a model: recall is a database query on your own machine, so there is nothing to bill.",
  },
  {
    q: "Where is my data stored?",
    a: "Two folders on your computer: .memory/ inside each project, and ~/.memory/ for anything that applies everywhere. Plain SQLite and YAML you can read, edit, back up, ignore, or commit to git. Nothing is uploaded.",
  },
  {
    q: "Will it slow my assistant down?",
    a: "No. A lookup runs in under two milliseconds locally with a hard token budget, so it returns a short list rather than everything. That is far cheaper than re-explaining your architecture in every new session.",
  },
  {
    q: "Does it work with the tools I already use?",
    a: "Yes. aimm connects to the majority of the coding agents people actually run — Claude Code, Cursor, Codex, Windsurf, Gemini CLI, OpenCode, Hermes, OpenClaw and the rest of the mainstream field. One command wires each of them; you keep working exactly as you do today.",
  },
  {
    q: "What if it remembers something wrong?",
    a: "aimm checks citations before storing them and re-checks them at recall. If the code a note points at has changed or disappeared, the note is withheld and you are told why, rather than served as if it were still true. Contradictions are marked conflicted instead of silently overwritten.",
  },
  {
    q: "What happens to passwords and API keys?",
    a: "They are refused. Every write is scanned for API keys, tokens, private keys and connection strings, and a suspected secret stops the write instead of being stored in a file you might later commit.",
  },
  {
    q: "Can I bring my existing notes?",
    a: "Yes. The importer reads other memory systems, and existing session transcripts can be turned into candidate notes. Your memory starts populated rather than empty.",
  },
  {
    q: "Is it really free?",
    a: "Yes. MIT-licensed, no paid tier, no telemetry. The whole engine — capture, ranking and recall — runs in-process on your machine, so there is no hosted component to charge for.",
  },
];

/* ── Glossary ─────────────────────────────────────────────────────────── */
const glossary = [
  { term: "AI coding agent", def: "An AI assistant that reads and edits code in your project — Claude Code, Cursor, Codex, Windsurf and similar tools." },
  { term: "Agent memory", def: "What an assistant keeps between sessions: decisions, fixes and preferences it can look up later instead of rediscovering." },
  { term: "Context window", def: "The fixed amount of text an assistant can consider at once. Anything outside it is invisible — which is why sessions forget." },
  { term: "MCP", def: "Model Context Protocol — the standard way assistants connect to outside tools like aimm. You never have to use the acronym." },
  { term: "Local-first", def: "The data lives and is processed on your own machine. No account, no upload, no service that can go down or change its pricing." },
  { term: "Code anchor", def: "A pointer from a note to a specific file or function. aimm uses a structural fingerprint instead of a line number, so refactors do not break it." },
];

/* ── Structured data ──────────────────────────────────────────────────── */
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "aimm",
    url: "https://harshsinghmp.github.io/musememory/",
    description:
      "Local-first memory for AI coding agents. aimm saves what your agent learns to plain files on your machine and hands the right notes back next session.",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "aimm",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    softwareVersion: claims.version,
    description:
      "Local-first memory for AI coding agents. Notes are checked against your code before they are stored, stale notes are withheld at recall, and the whole engine runs in-process on your machine.",
    url: "https://harshsinghmp.github.io/musememory/",
    downloadUrl: npm,
    codeRepository: repo,
    license: "https://opensource.org/licenses/MIT",
    runtimePlatform: "Node.js, Bun",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: [
      "One command wires the majority of coding agents over MCP",
      "Write-time citation verification",
      "Recall-time freshness gate",
      "In-process retrieval engine (sub-2ms recall)",
      "Deterministic lifecycle and forgetting",
      "Structural code anchors that survive refactors",
      "Credential scanning on every write",
      "Scoped failure attribution and decaying strike engine",
      "Trajectory fix-pair negative memory mining",
      "HOT.md working set compounding and logarithmic frequency ranking",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to give an AI coding agent memory that lasts",
    description:
      "Install aimm in one command and give your AI coding assistant memory that survives between sessions.",
    totalTime: "PT1M",
    tool: [{ "@type": "HowToTool", name: "A terminal" }],
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open a terminal in your project folder",
        text: "Open any terminal in the project you want your assistant to remember. No installation or account is required first.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Run npx musememory connect",
        text: "Run npx musememory connect. aimm detects the coding agents you already have and connects each one, so you do not configure them individually.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Keep working",
        text: "Your assistant now has memory tools available, including get_context for fused recall and muse_why for explaining why the code is the way it is. It starts remembering from the next session.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "aimm capabilities",
    itemListElement: features.map((f, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: f.title,
      description: f.body,
    })),
  },
];
---

<Base
  title="aimm — your AI agent gets a memory that lasts"
  description="aimm saves what your AI coding agent learns to plain files on your machine, then hands the right notes back next session. No cloud, no daemon, no re-explaining. Free, MIT, runs offline."
  jsonLd={jsonLd}
>
  <Nav />

  <main id="main">
    <!-- ══ HERO · outcome + audience + the objection removed ═════════════
         One primary action (install), one secondary (see it work). The card
         on the right is real UI: the command that runs and the files it
         writes, so "no cloud" is shown rather than asserted. -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <div class="mesh"></div>
        <div class="synapse-orb orb-a"></div>
        <div class="synapse-orb orb-b"></div>
      </div>

      <div class="container">
        <div class="bento hero-bento">
          <div class="hero-copy bento-span-8">
            <p class="eyebrow">Local-first memory for AI coding agents</p>

            <h1 id="hero-title" class="hero-title">
              Your agent forgets everything. Give it a memory that lasts.
            </h1>

            <p class="hero-sub">
              aimm saves what your agent learns to plain files on your machine,
              then hands the right notes back next session. No cloud, no daemon,
              no re-explaining.
            </p>

            <div class="hero-cta">
              <a class="btn btn-primary btn-lg" href="#install">Install in one command</a>
              <a class="btn btn-ghost btn-lg" href="#demo">See how recall works</a>
            </div>

            <ul class="chip-row hero-chips" aria-label="At a glance">
              {proofChips.map((chip) => (
                <li class="metric-chip">{chip}</li>
              ))}
            </ul>
          </div>

          <div class="bento-card bento-span-4 hero-card reveal">
            <p class="card-kicker">The whole setup</p>
            <div class="cmd-wrap">
              <pre class="term" aria-label="Terminal: install command"><code id="install-cmd">npx musememory connect</code></pre>
              {/* The button keeps one stable accessible name. Swapping the
                  visible label is not enough on its own: aria-label wins the
                  name computation, so an assistive-tech user never hears the
                  result. The live region below is what announces it. */}
              <button class="copy" type="button" data-copy="#install-cmd" aria-label="Copy the install command">
                <span data-copy-label>Copy</span>
                <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
              </button>
            </div>

            <p class="card-kicker">What it writes</p>
            <pre class="tree" aria-label="The files aimm writes inside your project"><code>{`project/
└── .memory/
    ├── memory.db    # SQLite
    ├── memories/    # YAML
    └── CURRENT.md`}</code></pre>

            <p class="hero-card-note">
              Open it in any editor. Commit it, diff it, or delete it — your
              memory is a folder, not an account.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ PROBLEM · PAS ═════════════════════════════════════════════════ -->
    <section class="section section--raised" id="problem" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The problem</p>
          <h2 id="problem-title">Why your agent forgets everything by Thursday</h2>
          <p class="answer">
            An assistant only knows what fits in its context window. When the
            session ends, that context is thrown away — so the next session
            starts from zero, and you pay again for what was settled yesterday.
          </p>
        </div>

        <div class="bento">
          {problems.map((p, i) => (
            <article
              class="bento-card bento-span-3 problem-card reveal"
              style={`--reveal-delay:${i * 70}ms`}
            >
              <span class="bento-icon" aria-hidden="true">
                <Icon name={p.icon} size={20} />
              </span>
              <h3>{p.title}</h3>
              <p class="bento-body">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ DEMO · the three outcomes, shown ═════════════════════════════ -->
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">See how recall works</p>
          <h2 id="demo-title">Every memory gets one of three outcomes</h2>
          <p class="answer">
            Nothing is stored on faith. A note is either confirmed against the
            code it cites, refused because that code does not exist, or
            withheld because the code moved on — and in that last case you are
            told why.
          </p>
        </div>

        <div class="bento">
          <figure class="bento-card bento-span-8 reel reveal">
            {/* width/height are the real dimensions of the poster frame
                (1280×720, 16:9). They give the element an intrinsic aspect
                ratio so the demo box is reserved before metadata arrives and
                the page below it does not jump. ffprobe is not a dependency of
                this repo, so the poster — rendered from the same reel — is the
                source of truth for the ratio. */}
            <video
              width="1280"
              height="720"
              controls
              muted
              loop
              playsinline
              preload="metadata"
              poster={`${base}/showreel-poster.png`}
              src={`${base}/showreel.mp4`}
            >
            </video>
            <figcaption>
              Ten seconds on the engine's story — every number on screen is a
              measured benchmark, not a claim.
            </figcaption>
          </figure>

          <div class="bento-span-4 outcome-stack">
            {outcomes.map((o, i) => (
              <article
                class={`bento-card outcome outcome-${o.tone} reveal`}
                style={`--reveal-delay:${i * 90}ms`}
              >
                <span class="outcome-badge" aria-hidden="true">
                  {o.tone === "ok" ? "✓" : o.tone === "no" ? "✕" : "!"}
                </span>
                <div>
                  <p class="outcome-title">{o.state}</p>
                  <p class="outcome-body"><code>{o.body}</code></p>
                  <p class="outcome-note">{o.note}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══ ARCHITECTURE · where the data lives ══════════════════════════ -->
    <section class="section section--raised" id="architecture" aria-labelledby="arch-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2 id="arch-title">Your data never leaves the machine</h2>
          <p class="answer">
            aimm is a process you start and stop. There is no server to
            operate, no account to create, and no network call in the path of a
            recall. The whole engine is a SQLite database and a folder of YAML
            files you can open in any editor.
          </p>
        </div>

        <div class="bento">
          <figure class="bento-card bento-span-12 figure reveal">
            <ArchitectureDiagram />
            <figcaption>
              One process, two scopes. Project memory travels with the repo;
              global memory holds the preferences that follow you.
            </figcaption>
          </figure>

          {steps.map((s, i) => (
            <article
              class="bento-card bento-span-4 step reveal"
              style={`--reveal-delay:${i * 100}ms`}
            >
              <div class="step-head">
                <span class="step-num" aria-hidden="true">{s.n}</span>
                <span class="step-icon" aria-hidden="true">
                  <Icon name={s.icon} size={20} />
                </span>
              </div>
              <h3>{s.title}</h3>
              <p class="step-plain">{s.plain}</p>
              <p class="step-tech">{s.tech}</p>
            </article>
          ))}

          <div class="bento-card bento-span-5 layout-copy reveal">
            <h3>Everything is a file you can read</h3>
            <p class="lede">
              Delete the folder and the memory is gone. Commit it and memory
              becomes code — reviewable in a pull request, revertible with
              <code>git revert</code>.
            </p>
          </div>

          <pre class="bento-card bento-span-7 term term--code reveal" aria-label="File layout of the memory store"><code>{`.memory/                                  # project scope
├── memory.db                             # SQLite: memories, anchors, graph
├── memories/                             # one YAML file per memory
├── CURRENT.md                            # active constraints
├── USER.md                               # your persona
├── observations.jsonl                    # the event log the harvester mines
└── audit.jsonl                           # tamper-evident write ledger

~/.memory/                                # global scope`}</code></pre>
        </div>
      </div>
    </section>

    <!-- ══ FEATURES · the bento grid ════════════════════════════════════ -->
    <section class="section" id="surface" aria-labelledby="surface-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">What you get</p>
          <h2 id="surface-title">Seven things that hold up under use</h2>
          <p class="answer">
            Each card is a capability you can run today. The command under it
            is the one you would actually type.
          </p>
        </div>

        <div class="bento">
          {features.map((f, i) => (
            <article
              class={`bento-card bento-span-${f.span} feature reveal`}
              style={`--reveal-delay:${i * 60}ms`}
            >
              <span class="bento-icon" aria-hidden="true">
                <Icon name={f.icon} size={20} />
              </span>
              <h3>{f.title}</h3>
              <p class="bento-body">{f.body}</p>
              <div class="bento-foot">
                <div class="chip-row">
                  <span class="metric-chip"><strong>{f.metric}</strong></span>
                </div>
                <p class="cmd">
                  <code>{f.cmd}</code>
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ PROOF · benchmarks as a bento ════════════════════════════════ -->
    <section class="section section--raised" id="proof" aria-labelledby="proof-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Proof</p>
          <h2 id="proof-title">Measured, not claimed</h2>
          <p class="answer">
            Recall is a local database query, not an API call, so it finishes
            in under two milliseconds. Run <code>memory benchmark</code> and
            you get the same numbers on your own machine.
          </p>
        </div>

        <div class="bento">
          <figure class="bento-card bento-span-6 figure reveal">
