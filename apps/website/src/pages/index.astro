  <style>
    /* nav & footer chrome lives in global.css (shared across all pages) */

    /* Parallax wrapper. The mesh inside animates its own transform, so the
       scroll offset has to live on a parent to avoid fighting the drift. */
    .parallax-layer {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: -1;
    }

    /* ── Hero: a lit stage, not a flat banner ─────────────────────────────── */
    .hero {
      position: relative;
      padding: clamp(3.4rem, 9vw, 6.5rem) 0 3rem;
      text-align: center;
      isolation: isolate;
    }
    .hero-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .hero-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.55em;
      font-size: var(--fs-small);
      color: var(--text-dim);
      border: 1px solid var(--line);
      background: var(--bg-raised);
      border-radius: 999px;
      padding: 0.45em 1.1em;
      margin-bottom: 1.5rem;
    }
    .pulse {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 0 rgba(95, 211, 154, 0.5);
      animation: pulse 2.2s infinite;
    }
    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(95, 211, 154, 0.5); }
      70% { box-shadow: 0 0 0 9px rgba(95, 211, 154, 0); }
      100% { box-shadow: 0 0 0 0 rgba(95, 211, 154, 0); }
    }

    h1 {
      font-size: var(--fs-hero);
      font-weight: 800;
      max-width: 22ch;
      margin: 0 auto 1.1rem;
      display: grid;
      gap: 0.15em;
    }
    /* The keyword phrase sits in the h1 for search, at a size that does not
       fight the promise underneath it. */
    .hero-keyword {
      display: block;
      font-size: 0.34em;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      background: linear-gradient(92deg, var(--cyan), var(--violet));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-promise {
      display: block;
      letter-spacing: -0.03em;
      background: linear-gradient(96deg, #fff 24%, var(--violet) 78%, var(--cyan));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .hero-sub {
      max-width: 46rem;
      margin: 0 auto 2rem;
      color: var(--text-dim);
      font-size: clamp(1.02rem, 1.7vw, 1.18rem);
    }
    .hero-cta {
      display: flex;
      gap: 0.9rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }

    .term {
      text-align: left;
      background: var(--bg-panel);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      padding: 1.1rem 1.3rem;
      max-width: 640px;
      margin: 0 auto;
      overflow-x: auto;
      box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
    }
    .hero > .container > .term { width: 100%; }
    /* Wrap rather than scroll: a horizontally scrollable <pre> is not keyboard
       reachable (axe scrollable-region-focusable, serious), and on a phone a
       command that wraps is easier to read than one you have to drag. */
    .term code {
      background: none;
      border: none;
      padding: 0;
      color: var(--text);
      font-size: 0.92rem;
      line-height: 1.7;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    /* ── Hero cards: three trust states, floating at different depths ─────── */
    .hero-cards {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      width: 100%;
      max-width: 940px;
      margin: 3rem auto 0;
      text-align: left;
    }
    .hero-card {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 46%), var(--bg-panel);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 1.1rem 1.15rem;
      box-shadow: inset 0 1px 0 var(--edge-light), 0 18px 40px var(--edge-dark);
