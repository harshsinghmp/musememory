      padding: clamp(1.7rem, 4vw, 2.9rem) 0;
      border-top: 1px solid var(--line);
    }
    .band:last-child { border-bottom: 1px solid var(--line); }
    .band:nth-child(even) .band-lead { order: 3; }
    .band:nth-child(even) .band-copy { order: 1; text-align: right; }
    .band:nth-child(even) .band-copy .band-stat { margin-left: auto; }
    .band-index {
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: clamp(1.5rem, 3.4vw, 2.5rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1;
      color: var(--text-faint);
      font-variant-numeric: tabular-nums;
    }
    .band-violet .band-index { color: var(--violet); }
    .band-cyan .band-index { color: var(--cyan); }
    .band-amber .band-index { color: var(--amber); }
    .band-green .band-index { color: var(--green); }
    .band-red .band-index { color: var(--red); }
    .band-lead h3 {
      font-size: clamp(1.3rem, 2.3vw, 1.8rem);
