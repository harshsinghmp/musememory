---
/**
 * Muse Memory — landing page.
 *
 * Copy framework: AIDA across the page spine (Attention → Interest → Desire
 * → Action) with PAS (Problem → Agitation → Solution) driving the problem
 * block, per the content skill's formula matrix for a developer-vertical
 * landing page read by a problem-aware engineer.
 *
 * Layout: the design skill's developer anatomy — hero → demo → architecture →
 * code grid → proof → quickstart → licence.
 *
 * Every countable claim comes from `claims.json`, which is generated from
 * `src/`. Nothing in this file is hand-typed except prose.
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import LatencyChart from "../components/figures/LatencyChart.astro";
import LifecycleDiagram from "../components/figures/LifecycleDiagram.astro";
import ArchitectureDiagram from "../components/figures/ArchitectureDiagram.astro";
import claims from "../../../../claims.json";

const base = import.meta.env.BASE_URL;
const repo = "https://github.com/harshsinghmp/musememory";
const npm = "https://www.npmjs.com/package/musememory";

/* ── The problem: PAS ─────────────────────────────────────────────────── */
const problems = [
  {
    icon: "reset",
    title: "Every session starts from zero",
    body: "You re-explain the architecture, the auth flow, the one decision nobody else understands. Every morning. The context window is a scratch pad, not a notebook.",
  },
  {
    icon: "git-branch",
    title: "Memory that ignores your git state",
    body: "Check out a hotfix and the agent still applies rules from the branch you abandoned. Stale facts leak into stable code and nobody notices until it ships.",
  },
  {
    icon: "coin",
    title: "A flat MEMORY.md is a cache killer",
    body: "Every edit invalidates the whole prefix. You pay to re-read the same context each session, and the file becomes nobody's source of truth.",
  },
  {
    icon: "blame",
    title: "No blame, no rollback",
    body: "A hallucinated rule poisons every future recall. There is no `git blame` for memory, no checkout, no way back to the state before the mistake.",
  },
];

/* ── The three outcomes every memory gets ─────────────────────────────── */
const outcomes = [
  {
    state: "Remembered",
    tone: "ok",
    body: "auth uses jose, not jsonwebtoken",
    note: "The cited symbol exists — handed back next session.",
  },
  {
    state: "Refused",
    tone: "no",
    body: "see src/legacy/auth.ts",
    note: "The file does not exist — the write never happens.",
  },
  {
    state: "Withheld",
    tone: "hold",
    body: "session store uses Redis",
    note: "The code drifted since the note — held back, and you are told why.",
  },
];

/* ── The three steps ──────────────────────────────────────────────────── */
const steps = [
  {
    n: "01",
    icon: "file-tree",
    title: "Remember it",
    plain:
      "When your agent makes a decision or fixes a bug, Muse saves a short note — what changed and why.",
    tech: "Every write passes a credential scan first, and the note lands as a readable YAML file beside a SQLite row.",
  },
  {
    n: "02",
    icon: "anchor",
    title: "Check it",
    plain:
      "Before the note is stored, Muse confirms the file or function it mentions actually exists.",
    tech: "Citations are structural fingerprints, not line numbers, so moving a function does not silently break the note.",
  },
  {
    n: "03",
    icon: "gauge",
    title: "Hand it back",
    plain:
      "Next session, Muse returns the notes that fit the task — sized to your budget, not the whole archive.",
    tech: "One in-process query over SQLite FTS5. Under 2ms, with a hard token ceiling. No daemon, no network, no model call.",
  },
];

/* ── Code-first feature grid: real surface, not marketing ──────────────── */
const features = [
  {
    icon: "plug",
    title: "One command wires your tools",
    body: "Muse detects the coding agents you already run and connects the memory server to each one over MCP — with no permission prompts and no config file to hand-edit.",
    code: "npx musememory connect",
    lang: "bash",
  },
  {
    icon: "shield-check",
    title: "Writes are scanned, not trusted",
    body: "Every write — capture, import, sync packet — is matched against credential patterns first. A suspected secret stops the write instead of landing in a file you might later commit.",
    code: 'memory capture "auth uses jose" --project core',
    lang: "bash",
  },
  {
    icon: "anchor",
    title: "Citations are verified at write time",
    body: "A note that points at a file or function which does not exist is rejected on the spot. Hallucinated citations never reach the store.",
    code: 'memory anchor create --file src/auth.ts --symbol verify',
    lang: "bash",
  },
  {
    icon: "clock-history",
    title: "Stale notes are withheld, not served",
    body: "At recall time Muse re-checks every citation. If the code moved on, the note is held back and reported — never handed over as if it were still true.",
    code: "muse_context  # returns withheld_memories + freshness_notice",
    lang: "mcp",
  },
  {
    icon: "git-branch",
    title: "Memory is versioned like code",
    body: "Scope memory to a branch, blame a note back to the session that wrote it, and roll back to a known-good state. Git for AI memory.",
    code: "memory branch m_1700… --path core/auth\nmemory blame m_1700…",
    lang: "bash",
  },
  {
    icon: "wand",
    title: "Failures become permanent lessons",
    body: "Muse watches the error → fix → no-recurrence sequence in your session logs and distills a negative memory, so the same mistake is not made twice.",
    code: 'memory capture --negative "AVOID: jwt.sign without an explicit algorithm"',
    lang: "bash",
  },
];

/* ── Proof ────────────────────────────────────────────────────────────── */
const benchmarks = [
  { label: "Recall latency", value: `sub-${claims.latency.recallMillis}ms`, note: "SQLite FTS5 BM25, in-process" },
  { label: "Hot cache lookup", value: `<${claims.latency.hotCacheMicros}µs`, note: "L0 in-process cache" },
  { label: "Import formats", value: String(claims.migratorProviders), note: "other memory systems" },
  { label: "Tests passing", value: claims.tests.count.toLocaleString("en-US"), note: `${claims.tests.files} files, runs offline` },
  { label: "Background services", value: String(claims.backgroundDaemons), note: "nothing to keep running" },
  { label: "MCP tools", value: String(claims.mcpTools), note: `${claims.mcpProfiles} task-focused profiles` },
];

/* ── Trust gates ──────────────────────────────────────────────────────── */
const gates = [
  { when: "On every write", what: "Credential scan", how: "The write is refused and the rule is named. The value is never echoed." },
  { when: "On every write", what: "Citation check", how: "A note citing a file or symbol that does not exist is refused." },
  { when: "On every recall", what: "Freshness gate", how: "Notes whose code drifted are withheld and reported, not served." },
  { when: "On every import", what: "Context stripping", how: "Injected context blocks and base64 payloads are removed before storage." },
];

/* ── Integration surface ──────────────────────────────────────────────── */
const surfaces = [
  { icon: "terminal", name: "CLI", detail: "80+ commands, scriptable, no daemon" },
  { icon: "plug", name: "MCP", detail: `${claims.mcpTools} tools over stdio` },
  { icon: "layers", name: "Profiles", detail: `${claims.mcpProfiles} task-shaped tool sets` },
  { icon: "file-tree", name: "Files", detail: "YAML + SQLite, yours to read" },
];

/* ── FAQ ──────────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: "Do I need to know how to program to install it?",
    a: "No, but you do need a terminal. The setup is one line you paste and run — no config file to write, no server to set up, no account to create.",
  },
  {
    q: "Do I need an API key or a subscription?",
    a: "No account, no API key, no subscription. Muse is MIT-licensed and free. It never calls a model: recall is a database query on your own machine, so there is nothing to bill.",
  },
  {
    q: "Where is my data stored?",
    a: "Two folders on your computer: .memory/ inside each project, and ~/.memory/ for anything that applies everywhere. Plain SQLite and YAML you can read, edit, back up, ignore, or commit to git. Nothing is uploaded.",
  },
  {
    q: "Will it slow my assistant down?",
    a: "No. A lookup runs in under two milliseconds locally with a hard token budget, so it returns a short list rather than everything. That is far cheaper than re-explaining your architecture in every new session.",
  },
  {
    q: "Does it work with the tools I already use?",
    a: "Yes. Muse connects to the majority of the coding agents people actually run — Claude Code, Cursor, Codex, Windsurf, Gemini CLI, OpenCode, Hermes, OpenClaw and the rest of the mainstream field. One command wires each of them; you keep working exactly as you do today.",
  },
  {
    q: "What if it remembers something wrong?",
    a: "Muse checks citations before storing them and re-checks them at recall. If the code a note points at has changed or disappeared, the note is withheld and you are told why, rather than served as if it were still true. Contradictions are marked conflicted instead of silently overwritten.",
  },
  {
    q: "What happens to passwords and API keys?",
    a: "They are refused. Every write is scanned for API keys, tokens, private keys and connection strings, and a suspected secret stops the write instead of being stored in a file you might later commit.",
  },
  {
    q: "Can I bring my existing notes?",
    a: "Yes. The importer reads other memory systems, and existing session transcripts can be turned into candidate notes. Your memory starts populated rather than empty.",
  },
  {
    q: "Is it really free?",
    a: "Yes. MIT-licensed, no paid tier, no telemetry. The whole engine — capture, ranking and recall — runs in-process on your machine, so there is no hosted component to charge for.",
  },
];

/* ── Glossary ─────────────────────────────────────────────────────────── */
const glossary = [
  { term: "AI coding agent", def: "An AI assistant that reads and edits code in your project — Claude Code, Cursor, Codex, Windsurf and similar tools." },
  { term: "Agent memory", def: "What an assistant keeps between sessions: decisions, fixes and preferences it can look up later instead of rediscovering." },
  { term: "Context window", def: "The fixed amount of text an assistant can consider at once. Anything outside it is invisible — which is why sessions forget." },
  { term: "MCP", def: "Model Context Protocol — the standard way assistants connect to outside tools like Muse. You never have to use the acronym." },
  { term: "Local-first", def: "The data lives and is processed on your own machine. No account, no upload, no service that can go down or change its pricing." },
  { term: "Code anchor", def: "A pointer from a note to a specific file or function. Muse uses a structural fingerprint instead of a line number, so refactors do not break it." },
];

/* ── Structured data ──────────────────────────────────────────────────── */
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Muse Memory",
    url: "https://harshsinghmp.github.io/musememory/",
    description:
      "Persistent, local-first memory for AI coding agents. Citations are verified before they are stored, stale memories are withheld at recall, and the whole engine runs in-process on your machine.",
    inLanguage: "en",
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Muse Memory",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "macOS, Linux, Windows",
    softwareVersion: claims.version,
    description:
      "Persistent, self-verifying memory for AI coding agents. Citations are verified at write time, stale memories are withheld at recall, failures are fairly attributed, and negative lessons are mined from fix trajectories.",
    url: "https://harshsinghmp.github.io/musememory/",
    downloadUrl: npm,
    codeRepository: repo,
    license: "https://opensource.org/licenses/MIT",
    runtimePlatform: "Node.js, Bun",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    featureList: [
      "Write-time citation verification",
      "Recall-time freshness gate",
      "In-process retrieval engine (sub-2ms recall)",
      "One command wires the majority of coding agents over MCP",
      "Deterministic lifecycle and forgetting",
      "Structural code anchors that survive refactors",
      "Credential scanning on every write",
      "Scoped failure attribution and decaying strike engine",
      "Trajectory fix-pair negative memory mining",
      "HOT.md working set compounding and logarithmic frequency ranking",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    name: "How to add persistent, self-verifying memory to an AI coding agent",
    description:
      "Install Muse Memory in one command and give your AI coding assistant memory that survives between sessions.",
    totalTime: "PT1M",
    tool: [{ "@type": "HowToTool", name: "A terminal" }],
    step: [
      {
        "@type": "HowToStep",
        position: 1,
        name: "Open a terminal in your project folder",
        text: "Open any terminal in the project you want your assistant to remember. No installation or account is required first.",
      },
      {
        "@type": "HowToStep",
        position: 2,
        name: "Run npx musememory connect",
        text: "Run npx musememory connect. Muse detects the coding agents you already have and connects each one, so you do not configure them individually.",
      },
      {
        "@type": "HowToStep",
        position: 3,
        name: "Keep working",
        text: "Your assistant now has memory tools available, including get_context for fused recall and muse_why for explaining why the code is the way it is. It starts remembering from the next session.",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Muse Memory capabilities",
    itemListElement: features.map((f, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: f.title,
      description: f.body,
    })),
  },
];
---

<Base
  title="Muse Memory — Persistent, self-verifying memory for AI coding agents"
  description="Muse Memory gives AI coding agents a memory that survives the session and checks itself. Citations are verified before they are stored, stale notes are withheld at recall, and one command wires the majority of coding agents. No account, no API key, MIT."
  jsonLd={jsonLd}
>
  <Nav />

  <main id="main">
    <!-- ══ BLOCK 1 · HERO — utility first, one-command install ══════════════ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true">
        <div class="mesh"></div>
        <div class="synapse-orb orb-a"></div>
        <div class="synapse-orb orb-b"></div>
      </div>

      <div class="container hero-inner">
        <p class="hero-kicker">
          <span class="pulse" aria-hidden="true"></span>
          v{claims.version} · Runs on your machine · No account · MIT
        </p>

        <h1 id="hero-title" class="hero-title">
          Persistent, self-verifying memory for AI coding agents
        </h1>

        <p class="hero-sub">
          Muse stores what your agent learned — the decisions, the fixes, the
          constraints — checks every note against the code it cites, and hands
          back only what still holds. In-process, sub-2ms, no daemon.
        </p>

        <div class="hero-install">
          <pre class="term" aria-label="Terminal: install command"><code id="install-cmd">npx musememory connect</code></pre>
          <button class="copy" type="button" data-copy="#install-cmd" aria-label="Copy the install command">
            <span data-copy-label>Copy</span>
          </button>
        </div>

        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#install">Get memory in one command</a>
          <a class="btn btn-ghost btn-lg" href={`${base}/docs`}>Read the docs</a>
        </div>

        <dl class="hero-stats">
          {benchmarks.slice(0, 4).map((b) => (
            <div class="hero-stat">
              <dt>{b.label}</dt>
              <dd>{b.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ══ BLOCK 2 · PROBLEM — PAS ═══════════════════════════════════════ -->
    <section class="section section--raised" id="problem" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The problem</p>
          <h2 id="problem-title">Why your agent forgets everything by Thursday</h2>
          <p class="answer">
            An assistant only knows what fits in its context window. When the
            session ends that context is discarded, so the next session starts
            from zero — and the cost compounds every time you re-explain
            something that was settled yesterday.
          </p>
        </div>

        <div class="grid grid-4 problem-grid">
          {problems.map((p, i) => (
            <article class="panel problem-card reveal" style={`--reveal-delay:${i * 70}ms`}>
              <span class="problem-icon" aria-hidden="true">
                <Icon name="clock-history" size={20} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ BLOCK 3 · DEMO — show, don't tell ════════════════════════════ -->
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Show, don't tell</p>
          <h2 id="demo-title">Every memory gets one of three outcomes</h2>
          <p class="answer">
            Nothing is stored on faith. A note is either confirmed against the
            code it cites, refused because that code does not exist, or
            withheld because the code moved on since — and in that last case
            you are told why.
          </p>
        </div>

        <div class="demo-grid">
          <figure class="reel panel reveal">
            <video
              controls
              muted
              loop
              playsinline
              preload="metadata"
              poster={`${base}/showreel-poster.png`}
              src={`${base}/showreel.mp4`}
            >
            </video>
            <figcaption>
              Ten seconds on the engine's story — every number on screen is a
              measured benchmark, not a claim.
            </figcaption>
          </figure>

          <ul class="outcome-list">
            {outcomes.map((o, i) => (
              <li class={`outcome outcome-${o.tone} panel reveal`} style={`--reveal-delay:${i * 90}ms`}>
                <span class="outcome-badge" aria-hidden="true">
                  {o.tone === "ok" ? "✓" : o.tone === "no" ? "✕" : "!"}
                </span>
                <p class="outcome-title">{o.state}</p>
                <p class="outcome-body"><code>{o.body}</code></p>
                <p class="outcome-note">{o.note}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ══ BLOCK 4 · ARCHITECTURE & MECHANICS ═══════════════════════════ -->
    <section class="section section--raised" id="architecture" aria-labelledby="arch-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">How it works</p>
          <h2 id="arch-title">Your data never leaves the machine</h2>
          <p class="answer">
            Muse runs as a process you start and stop. There is no server to
            operate, no account to create, and no network call in the path of
            a recall. The whole engine is a SQLite database and a folder of
            YAML files you can open in any editor.
          </p>
        </div>

        <figure class="figure panel reveal">
          <ArchitectureDiagram />
          <figcaption>
            One process, two scopes. Project memory travels with the repo;
            global memory holds the preferences that follow you.
          </figcaption>
        </figure>

        <div class="grid grid-3 step-grid">
          {steps.map((s, i) => (
            <article class="step panel reveal hoverable" style={`--reveal-delay:${i * 100}ms`}>
              <div class="step-head">
                <span class="step-num" aria-hidden="true">{s.n}</span>
                <span class="step-icon" aria-hidden="true">
                  <Icon name={s.icon} size={20} />
                </span>
              </div>
              <h3>{s.title}</h3>
              <p class="step-plain">{s.plain}</p>
              <p class="step-tech">{s.tech}</p>
            </article>
          ))}
        </div>

        <div class="layout-split">
          <div class="layout-copy">
            <h3>Everything is a file you can read</h3>
            <p class="lede">
              Delete the folder and the memory is gone. Commit it and memory
              becomes code — reviewable in a pull request, revertible with
              <code>git revert</code>.
            </p>
          </div>
          <pre class="term" aria-label="File layout of the memory store"><code>{`.memory/                                  # project scope
├── memory.db                             # SQLite: memories, anchors, graph
├── memories/                             # one YAML file per memory
├── CURRENT.md                            # active constraints
├── USER.md                               # your persona
├── observations.jsonl                    # the event log the harvester mines
└── audit.jsonl                           # tamper-evident write ledger

~/.memory/                                # global scope`}</code></pre>
        </div>
      </div>
    </section>

    <!-- ══ BLOCK 5 · CODE-FIRST FEATURE GRID ════════════════════════════ -->
    <section class="section" id="surface" aria-labelledby="surface-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">The surface</p>
          <h2 id="surface-title">Real commands, real tools</h2>
          <p class="answer">
            Every capability below is something you can run right now. No
            dashboards to configure, no workflows to author — a command, or a
            tool your agent calls.
          </p>
        </div>

        <div class="grid grid-2 feature-grid">
          {features.map((f, i) => (
            <article class="feature panel reveal hoverable" style={`--reveal-delay:${i * 60}ms`}>
              <div class="feature-head">
                <span class="feature-icon" aria-hidden="true">
                  <Icon name={f.icon} size={20} />
                </span>
                <h3>{f.title}</h3>
              </div>
              <p class="feature-body">{f.body}</p>
              <pre class="term term--code"><code>{f.code}</code></pre>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ BLOCK 6 · PROOF ══════════════════════════════════════════════ -->
    <section class="section section--raised" id="proof" aria-labelledby="proof-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Proof</p>
          <h2 id="proof-title">Measured, not claimed</h2>
          <p class="answer">
            Recall takes under two milliseconds because it is a local database
            query, not an API call. The hot cache answers in under fifty
            microseconds. Run <code>memory benchmark</code> to reproduce every
            number on this page.
          </p>
        </div>

        <div class="proof-grid">
          <figure class="figure panel reveal">
            <LatencyChart />
            <figcaption>
              Latency on the same machine, same store. The network row is a
              reference point, not a Muse claim.
            </figcaption>
          </figure>

          <div class="proof-side">
            <dl class="metric-grid">
              {benchmarks.map((b) => (
                <div class="metric panel panel--flush hoverable">
                  <dt>{b.label}</dt>
                  <dd>{b.value}</dd>
                  <dd class="metric-note">{b.note}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>

        <div class="gates-block">
          <h3 class="gates-title">Four gates, every time</h3>
          <div class="gates-list">
            {gates.map((g) => (
              <div class="gate reveal">
                <span class="gate-when">{g.when}</span>
                <span class="gate-what">{g.what}</span>
                <span class="gate-how">{g.how}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ══ LIFECYCLE ══════════════════════════════════════════════════════ -->
    <section class="section" id="lifecycle" aria-labelledby="lifecycle-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Lifecycle</p>
          <h2 id="lifecycle-title">Notes have a life, and an end</h2>
          <p class="answer">
            Nothing is written and forgotten. Every note moves through a
            deterministic lifecycle, decays on a schedule tied to how much
            you trust it, and can be restored if you delete it by mistake.
          </p>
        </div>
        <figure class="figure panel reveal">
          <LifecycleDiagram />
          <figcaption>
            <code>confirmed</code> is the only state served by default. A
            deletion is a tombstone — <code>memory restore</code> brings it
            back.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- ══ COMPARE ═══════════════════════════════════════════════════════ -->
    <section class="section section--raised" id="compare" aria-labelledby="compare-title">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Landscape</p>
          <h2 id="compare-title">How it is different</h2>
          <p class="answer">
            Vector stores optimise for similarity and graph platforms for
            relationships. Muse optimises for what a coding assistant
            actually needs: recall that is fast, local and tied to your code —
            and that never passes off a stale fact as current.
          </p>
        </div>
        <div class="table-wrap reveal">
          <table class="compare">
            <caption class="sr-only">
              Capability comparison between Muse Memory, dense vector stores,
