                ["Recall-time freshness gate", true, false, false],
                ["Deterministic lifecycle state machine", true, false, true],
                ["Structural anchors that survive refactors", true, false, false],
                ["Secret scanning on every write", true, false, false],
                ["One command wires your agents", true, false, false],
                ["Memory files you can review in git", true, false, false],
