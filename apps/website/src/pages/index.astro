    /* ── Editorial capability bands ──────────────────────────────────────── */
    .bands { display: grid; gap: 0; margin-top: 1rem; }
    .band {
      display: grid;
      grid-template-columns: minmax(74px, 92px) minmax(260px, 1fr) minmax(320px, 1.25fr);
      gap: clamp(1.2rem, 4vw, 3.5rem);
