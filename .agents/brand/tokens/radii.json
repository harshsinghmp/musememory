# Border Radius Tokens

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0"
    },
    "sm": {
      "$type": "dimension",
      "$value": "0.25rem",
      "$description": "Buttons, inputs — 4px"
    },
    "md": {
      "$type": "dimension",
      "$value": "0.5rem",
      "$description": "Cards, containers — 8px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "0.75rem",
      "$description": "Modals, large cards — 12px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "1rem",
      "$description": "Hero cards, feature blocks — 16px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Pills, avatars, circular"
    }
  }
}
