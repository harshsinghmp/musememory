# Spacing Tokens

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "space": {
    "0": { "$type": "dimension", "$value": "0" },
    "1": {
      "$type": "dimension",
      "$value": "clamp(0.25rem, 0.2rem + 0.1vw, 0.25rem)",
      "$description": "Tight gaps"
    },
    "2": {
      "$type": "dimension",
      "$value": "clamp(0.5rem, 0.4rem + 0.2vw, 0.5rem)",
      "$description": "Small gaps"
    },
    "3": {
      "$type": "dimension",
      "$value": "clamp(0.75rem, 0.6rem + 0.3vw, 0.75rem)",
      "$description": "Default gaps"
    },
    "4": {
      "$type": "dimension",
      "$value": "clamp(1rem, 0.8rem + 0.4vw, 1rem)",
      "$description": "Medium gaps"
    },
    "5": {
      "$type": "dimension",
      "$value": "clamp(1.25rem, 1rem + 0.5vw, 1.25rem)",
      "$description": "Section spacing"
    },
    "6": {
      "$type": "dimension",
      "$value": "clamp(1.5rem, 1.2rem + 0.6vw, 1.5rem)",
      "$description": "Large gaps"
    },
    "8": {
      "$type": "dimension",
      "$value": "clamp(2rem, 1.6rem + 0.8vw, 2rem)",
      "$description": "Section margins"
    },
    "10": {
      "$type": "dimension",
      "$value": "clamp(2.5rem, 2rem + 1vw, 2.5rem)",
      "$description": "Large section margins"
    },
    "12": {
      "$type": "dimension",
      "$value": "clamp(3rem, 2.4rem + 1.2vw, 3rem)",
      "$description": "Hero spacing"
    },
    "16": {
      "$type": "dimension",
      "$value": "clamp(4rem, 3.2rem + 1.6vw, 4rem)",
      "$description": "Page section gaps"
    },
    "20": {
      "$type": "dimension",
      "$value": "clamp(5rem, 4rem + 2vw, 5rem)",
      "$description": "Major section breaks"
    },
    "24": {
      "$type": "dimension",
      "$value": "clamp(6rem, 4.8rem + 2.4vw, 6rem)",
      "$description": "Page-level spacing"
    }
  }
}
