# Typography Tokens

{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "fontFamily": {
    "heading": {
      "$type": "fontFamily",
      "$value": "'Inter', system-ui, -apple-system, sans-serif"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "'Inter', system-ui, -apple-system, sans-serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "'JetBrains Mono', ui-monospace, monospace"
    }
  },
  "fontSize": {
    "xs": {
      "$type": "dimension",
      "$value": "clamp(0.625rem, 0.5rem + 0.25vw, 0.75rem)",
      "$description": "Captions, badges — 10-12px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "clamp(0.75rem, 0.65rem + 0.25vw, 0.875rem)",
      "$description": "Small text, labels — 12-14px"
    },
    "base": {
      "$type": "dimension",
      "$value": "clamp(0.875rem, 0.8rem + 0.2vw, 1rem)",
      "$description": "Body text — 14-16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "clamp(1rem, 0.9rem + 0.3vw, 1.125rem)",
      "$description": "Large body, intro — 16-18px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "clamp(1.125rem, 1rem + 0.5vw, 1.25rem)",
      "$description": "Subheadings — 18-20px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "clamp(1.25rem, 1rem + 1vw, 1.5rem)",
      "$description": "Section headings — 20-24px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "clamp(1.5rem, 1.2rem + 1.5vw, 2rem)",
      "$description": "Page headings — 24-32px"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "clamp(1.875rem, 1.5rem + 2vw, 2.5rem)",
      "$description": "Hero headings — 30-40px"
    },
    "5xl": {
      "$type": "dimension",
      "$value": "clamp(2.25rem, 1.8rem + 2.5vw, 3rem)",
      "$description": "Display headings — 36-48px"
    }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.2, "$description": "Headings" },
    "snug": { "$type": "number", "$value": 1.375, "$description": "Subheadings" },
    "normal": { "$type": "number", "$value": 1.5, "$description": "Body text" },
    "relaxed": { "$type": "number", "$value": 1.625, "$description": "Long-form content" }
  }
}

