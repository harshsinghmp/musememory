{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory-entry",
  "title": "MemoryEntry",
  "type": "object",
  "required": ["id", "title", "content", "project", "status", "created_at", "updated_at", "source", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^m_[0-9]+_[a-z0-9_-]+$" },
    "title": { "type": "string", "maxLength": 120 },
    "content": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["candidate", "active", "confirmed", "superseded", "stale", "disputed", "rejected", "conflicted"] },
    "type": { "type": "string", "enum": ["session", "decision", "fix", "failure", "architecture", "operation", "constraint", "preference", "discovery", "negative"] },
    "salience": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "due_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "reinforcement": { "type": "integer" },
    "source": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "supersedes": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "disputed_by": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["unverified", "observed", "reproducible", "user-confirmed", "authoritative", "independently-verified"] },
        "method": { "type": "string" },
        "verified_by": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "test_command": { "type": "string" },
        "test_result": { "type": "string" }
      },
      "additionalProperties": false
    },
    "last_confirmed_at": { "type": ["string", "null"], "format": "date-time" },
    "related_memory_ids": { "type": "array", "items": { "type": "string" } },
    "session_id": { "type": "string" },
    "test_command": { "type": "string" },
    "graph": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string" },
        "graph_revision": { "type": "string" },
        "node_ids": { "type": "array", "items": { "type": "string" } },
        "symbol_names": { "type": "array", "items": { "type": "string" } },
        "affected_paths": { "type": "array", "items": { "type": "string" } },
        "impact_query": { "type": "string" },
        "graph_verified_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "fingerprint": { "type": "string" },
    "temporal_mode": { "type": "string", "enum": ["current", "historical", "timeless"] },
    "quality": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "VERIFIED", "CONFLICTED", "STALE"] },
    "utility": {
      "type": "object",
      "properties": {
        "retrieval_count": { "type": "number" },
        "application_count": { "type": "number" },
        "successful_applications": { "type": "number" },
        "failed_applications": { "type": "number" },
        "regressions": { "type": "number" },
        "contradictions": { "type": "number" },
        "last_applied_at": { "type": "string" },
        "reuse_success_rate": { "type": "number" }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "timestamp"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "source": { "type": "string" },
          "timestamp": { "type": "string" },
          "excerpt": { "type": "string" },
          "confidence": { "type": "number" }
        }
      }
    },
    "conflict_ids": { "type": "array", "items": { "type": "string" } },
    "canonical_id": { "type": "string" },
    "negative": {
      "type": "object",
      "required": ["failed_approach", "failure_reason"],
      "properties": {
        "failed_approach": { "type": "string" },
        "failure_reason": { "type": "string" },
        "alternative_recommended": { "type": "string" },
        "reproduction_command": { "type": "string" },
        "evidence_snippet": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
