{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "memory-entry",
  "title": "MemoryEntry",
  "type": "object",
  "required": ["id", "title", "content", "project", "status", "created_at", "updated_at", "source", "tags"],
  "properties": {
    "id": { "type": "string", "pattern": "^m_[0-9]+_[a-z0-9_-]+$" },
    "title": { "type": "string", "maxLength": 120 },
    "content": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["candidate", "active", "confirmed", "superseded", "stale", "disputed", "rejected"] },
    "type": { "type": "string", "enum": ["session", "decision", "fix", "failure", "architecture", "operation", "constraint", "preference", "discovery"] },
    "salience": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_to": { "type": "string", "format": "date-time" },
    "reinforcement": { "type": "integer" },
    "source": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "supersedes": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "superseded_by": { "type": ["string", "array", "null"], "items": { "type": "string" } },
    "disputed_by": { "type": "array", "items": { "type": "string" } },
    "verification": {
      "type": "object",
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "enum": ["unverified", "observed", "reproducible", "user-confirmed", "authoritative", "independently-verified"] },
        "method": { "type": "string" },
        "verified_by": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "test_command": { "type": "string" },
        "test_result": { "type": "string" }
      },
      "additionalProperties": false
    },
    "last_confirmed_at": { "type": ["string", "null"], "format": "date-time" },
    "related_memory_ids": { "type": "array", "items": { "type": "string" } },
    "session_id": { "type": "string" },
    "recurring": {
      "type": "object",
      "required": ["interval"],
      "properties": {
        "interval": { "type": "string" },
        "next_due": { "type": ["string", "null"], "format": "date-time" }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string" },
        "graph_revision": { "type": "string" },
        "node_ids": { "type": "array", "items": { "type": "string" } },
        "symbol_names": { "type": "array", "items": { "type": "string" } },
        "affected_paths": { "type": "array", "items": { "type": "string" } },
        "impact_query": { "type": "string" },
        "graph_verified_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
