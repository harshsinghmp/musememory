{
  "name": "musememory",
  "version": "3.5.1",
  "description": "musememory — local-first memory for AI coding agents",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bench:graph": "bun scripts/bench-graph.ts",
    "bench:vector": "bun scripts/bench-vector.ts",
    "agents:terrain": "bun run bin/musememory.ts terrain --workspace --out .agents/terrain",
    "build": "bun build bin/musememory.ts --outfile dist/index.js --target node --external sqlite-vec",
    "sbom": "bun scripts/generate-sbom.ts",
    "checksums": "bun scripts/generate-sbom.ts --checksums",
    "site:dev": "bun run --cwd apps/website dev",
    "site:build": "bun run --cwd apps/website build",
    "site:preview": "bun run --cwd apps/website preview",
    "site:showreel": "bun run --cwd apps/website scripts/build-showreel.ts",
    "site:brand": "bun run --cwd apps/website brand",
    "site:audit:a11y": "bun run --cwd apps/website scripts/audit-a11y.ts",
    "site:audit:visual": "bun run --cwd apps/website scripts/audit-visual.ts",
    "build:gif": "bun run --cwd apps/website scripts/build-readme-gif.ts",
    "claims:generate": "bun scripts/generate-claims.ts && bun scripts/generate-cli-reference.ts",
    "claims:check": "bun scripts/generate-claims.ts --check",
    "cli:check": "bun scripts/generate-cli-reference.ts --check",
    "changelog:check": "bun scripts/check-changelog.ts",
    "check:landed": "bun run scripts/check-landed.ts",
    "check:landed:pr": "bun run scripts/check-landed.ts --pr",
    "docs:check": "bun scripts/check-doc-links.ts",
    "test": "bun test --timeout 20000",
    "typecheck": "tsc --noEmit",
    "validate": "bun run dist/index.js validate --dry-run",
    "start": "bun run dist/index.js mcp",
    "prepublishOnly": "bun run build && bun test --timeout 20000",
    "site:qa": "bun run --cwd apps/website scripts/qa-gate.ts",
    "showreel:hash": "bun scripts/showreel-hash.ts",
    "showreel:hash:write": "bun scripts/showreel-hash.ts --write"
  },
  "bin": {
    "memory": "dist/index.js",
    "musememory": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    ".agents",
    "schema.json",
    "claims.json",
    "docs/agent-reference.md",
    "docs/cli-reference.md",
    "docs/mcp-tool-matrix.json",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "ai",
    "agent",
    "memory",
    "mcp",
    "model-context-protocol",
    "llm",
    "cognitive-architecture",
    "vibeguard",
    "agency"
  ],
  "author": "Harsh Singh",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/harshsinghmp/musememory.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.17.1",
    "js-yaml": "^5.5.0",
    "sqlite-vec": "0.1.9"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.6.0"
  }
}
